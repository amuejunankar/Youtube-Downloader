# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the YouTube Downloader desktop build.

Builds a *folder* build by default:

    pyinstaller --noconfirm --clean YouTubeDownloader.spec

Set the environment variable ``YD_ONEFILE=1`` to instead build a single
self-contained ``YouTubeDownloader.exe``:

    set YD_ONEFILE=1
    pyinstaller --noconfirm --clean YouTubeDownloader.spec

FFmpeg/FFprobe are auto-detected and, when ``YD_BUNDLE_FFMPEG=1`` is set,
bundled into the build so high-resolution merging and MP3 conversion work on
machines without FFmpeg installed.
"""

import os
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_all

ROOT = Path(SPECPATH)
sys.path.insert(0, str(ROOT))

from app.utils import detect_ffmpeg  # noqa: E402

# --- yt-dlp data files + submodules (extractor list, etc.) --------------- #
yt_datas, yt_binaries, yt_hidden = collect_all("yt_dlp")

# --- FFmpeg / FFprobe ---------------------------------------------------- #
# Off by default: the binaries are large (~200 MB each) and the app already
# auto-detects FFmpeg from PATH / WinGet. Set YD_BUNDLE_FFMPEG=1 to ship a
# fully self-contained build.
ffmpeg_binaries = []
if os.environ.get("YD_BUNDLE_FFMPEG") == "1":
    _status = detect_ffmpeg()
    for _candidate in (_status.ffmpeg, _status.ffprobe):
        if not _candidate:
            continue
        _resolved = Path(_candidate).resolve()
        if _resolved.is_file():
            ffmpeg_binaries.append((str(_resolved), "."))

# --- Icon (generated by scripts/make_icon.py) ---------------------------- #
_icon = ROOT / "assets" / "app.ico"
icon_path = str(_icon) if _icon.is_file() else None

hidden = list(yt_hidden) + ["PySide6.QtSvg", "PySide6.QtNetwork"]

a = Analysis(
    [str(ROOT / "main.py")],
    pathex=[str(ROOT)],
    binaries=ffmpeg_binaries + yt_binaries,
    datas=yt_datas,
    hiddenimports=hidden,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)

pyz = PYZ(a.pure)

_exe_common = dict(
    name="YouTubeDownloader",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=icon_path,
)

if os.environ.get("YD_ONEFILE") == "1":
    exe = EXE(pyz, a.scripts, a.binaries, a.datas, [], **_exe_common)
else:
    exe = EXE(pyz, a.scripts, [], exclude_binaries=True, **_exe_common)
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name="YouTubeDownloader",
    )
