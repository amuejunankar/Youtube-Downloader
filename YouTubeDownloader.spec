# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the YouTube Downloader desktop build.

Builds a *folder* build by default:

    pyinstaller --noconfirm --clean YouTubeDownloader.spec

Set the environment variable ``YD_ONEFILE=1`` to instead build a single
self-contained ``YouTubeDownloader.exe``:

    set YD_ONEFILE=1
    pyinstaller --noconfirm --clean YouTubeDownloader.spec

FFmpeg/FFprobe are auto-detected and, when ``YD_BUNDLE_FFMPEG=1`` is set,
bundled into the build so high-resolution merging and MP3 conversion work on
machines without FFmpeg installed.
"""

import os
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_all

ROOT = Path(SPECPATH)
sys.path.insert(0, str(ROOT))

from app.utils import detect_ffmpeg  # noqa: E402,F401  (also used by scripts)

# --- yt-dlp data files + submodules (extractor list, etc.) --------------- #
yt_datas, yt_binaries, yt_hidden = collect_all("yt_dlp")

# --- yt-dlp-ejs challenge solver scripts --------------------------------- #
# Shipped by ``yt-dlp[default]``. Without them yt-dlp cannot solve YouTube's
# JavaScript challenges, which costs formats and causes failed downloads.
try:
    ejs_datas, ejs_binaries, ejs_hidden = collect_all("yt_dlp_ejs")
except Exception:  # plain `pip install yt-dlp`, no [default] extra
    ejs_datas, ejs_binaries, ejs_hidden = [], [], []

# --- Bundled JavaScript runtime (QuickJS-NG) ----------------------------- #
# Fetched by scripts/fetch_js_runtime.py; the app falls back to Deno/Node from
# PATH when it is absent.
js_binaries = []
_js_dir = ROOT / "vendor" / "js"
if _js_dir.is_dir():
    for _entry in sorted(_js_dir.iterdir()):
        if _entry.is_file():
            js_binaries.append((str(_entry), "."))

# --- FFmpeg / FFprobe ---------------------------------------------------- #
# Off by default: the binaries are large and the app auto-detects FFmpeg from
# PATH / WinGet. Set YD_BUNDLE_FFMPEG=1 to ship a fully self-contained build.
#
# Only binaries that actually run are bundled, and a requested bundle with
# nothing usable fails the build. Bundling whatever ``ffmpeg.exe`` PATH
# returned used to ship a package-manager shim that could not run on the
# user's machine, which made every merged download fail.
ffmpeg_binaries = []
if os.environ.get("YD_BUNDLE_FFMPEG") == "1":
    from app.utils import ffmpeg_binaries_for_bundling

    _usable = ffmpeg_binaries_for_bundling()
    if not _usable:
        raise SystemExit(
            "YD_BUNDLE_FFMPEG=1 but no working FFmpeg/FFprobe was found. "
            "Run 'python scripts/fetch_ffmpeg.py' before building."
        )
    ffmpeg_binaries = [(str(Path(_p).resolve()), ".") for _p in _usable]

# --- Icon (generated by scripts/make_icon.py) ---------------------------- #
_icon = ROOT / "assets" / "app.ico"
icon_path = str(_icon) if _icon.is_file() else None

hidden = list(yt_hidden) + list(ejs_hidden) + ["PySide6.QtSvg", "PySide6.QtNetwork"]

a = Analysis(
    [str(ROOT / "main.py")],
    pathex=[str(ROOT)],
    binaries=ffmpeg_binaries + yt_binaries + ejs_binaries + js_binaries,
    datas=yt_datas + ejs_datas,
    hiddenimports=hidden,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)

pyz = PYZ(a.pure)

_exe_common = dict(
    name="YouTubeDownloader",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=icon_path,
)

if os.environ.get("YD_ONEFILE") == "1":
    exe = EXE(pyz, a.scripts, a.binaries, a.datas, [], **_exe_common)
else:
    exe = EXE(pyz, a.scripts, [], exclude_binaries=True, **_exe_common)
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name="YouTubeDownloader",
    )
